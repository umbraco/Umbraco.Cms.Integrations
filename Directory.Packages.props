<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      One place to move the Umbraco CMS floor for every package. Referenced by the
      Umbraco.Cms.* PackageVersion entries below.

      The v17 line has a property of the same name, but declared in all eight
      csprojs rather than once - and it has already drifted, six of them reading
      "[17.0.0, 18)" and two "[17.0.0, 18.0.0)". Central package management plus a
      single property is the same idea without the copies.
    -->
    <UmbracoCmsPackageVersion>[18.0.0, 19.0.0)</UmbracoCmsPackageVersion>
  </PropertyGroup>

  <!-- Global tooling: SourceLink, versioning, Umbraco analyzers -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.8.118" />
    <GlobalPackageReference Include="Umbraco.Code" Version="3.0.0-beta" />
    <GlobalPackageReference Include="Umbraco.GitVersioning.Extensions" Version="0.2.0" />
    <GlobalPackageReference Include="Umbraco.JsonSchema.Extensions" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Umbraco CMS v18 - version comes from UmbracoCmsPackageVersion above -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoCmsPackageVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoCmsPackageVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoCmsPackageVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoCmsPackageVersion)" />
  </ItemGroup>

  <!-- Package-specific third-party dependencies -->
  <ItemGroup>
    <!-- Umbraco.Cms.Integrations.Search.Algolia -->
    <PackageVersion Include="Algolia.Search" Version="6.13.0" />
  </ItemGroup>

  <!-- Test dependencies. Versions match Umbraco.Automate / Umbraco.AI. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
