<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Global tooling: SourceLink, versioning, Umbraco analyzers -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.8.118" />
    <GlobalPackageReference Include="Umbraco.Code" Version="3.0.0-beta" />
    <GlobalPackageReference Include="Umbraco.GitVersioning.Extensions" Version="0.2.0" />
    <GlobalPackageReference Include="Umbraco.JsonSchema.Extensions" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Umbraco CMS v18 -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.0.0, 19.0.0)" />
  </ItemGroup>

  <!-- Package-specific third-party dependencies -->
  <ItemGroup>
    <!-- Umbraco.Cms.Integrations.Search.Algolia -->
    <PackageVersion Include="Algolia.Search" Version="6.13.0" />
  </ItemGroup>
</Project>
