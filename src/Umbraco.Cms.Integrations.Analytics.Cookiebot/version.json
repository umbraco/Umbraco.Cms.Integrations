{
    "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/master/src/NerdBank.GitVersioning/version.schema.json",
    "version": "5.0.0",
    "assemblyVersion": { "precision": "build" },
    "gitCommitIdShortFixedLength": 7,
    "nugetPackageVersion": { "semVer": 2 },
    "publicReleaseRefSpec": ["^refs/heads/main-v19$", "^refs/heads/v19/release/", "^refs/heads/v19/hotfix/"],
    "cloudBuild": { "buildNumber": { "enabled": false } }
}
