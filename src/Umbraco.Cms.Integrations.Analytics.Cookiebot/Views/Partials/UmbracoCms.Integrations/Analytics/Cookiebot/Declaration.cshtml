@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var cbid = Configuration["Umbraco:Cookiebot:Settings:Id"];
}

@* Without a configured domain group ID the src would be
   https://consent.cookiebot.com//cd.js - a guaranteed failing request - so render
   nothing instead. *@
@if (!string.IsNullOrWhiteSpace(cbid))
{
    <script id="CookieDeclaration"
            src="https://consent.cookiebot.com/@cbid/cd.js"
            type="text/javascript" async>
    </script>
}
